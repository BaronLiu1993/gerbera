#include <Arduino.h>
$includes

struct SerialField {
  String name;
  String value;
};

struct SerialMessage {
  String type;
  String target;
  SerialField fields[$max_message_fields];
  size_t fieldCount = 0;

  String field(const String& name) const {
    for (size_t index = 0; index < fieldCount; ++index) {
      if (fields[index].name == name) {
        return fields[index].value;
      }
    }
    return "";
  }
};

bool decodeMessage(const String& line, SerialMessage& message) {
  message.fieldCount = 0;
  int firstComma = line.indexOf(',');
  if (firstComma < 0) {
    return false;
  }

  const int length = line.length();
  int end = line.indexOf(',', firstComma + 1);
  if (end < 0) {
    end = length;
  }
  message.type = line.substring(0, firstComma);
  message.target = line.substring(firstComma + 1, end);
  message.type.trim();
  message.target.trim();
  if (message.type.length() == 0 || message.target.length() == 0 ||
      message.type.indexOf(':') >= 0 || message.target.indexOf(':') >= 0) {
    return false;
  }

  while (end < length) {
    if (message.fieldCount == $max_message_fields) {
      return false;
    }
    int start = end + 1;
    end = line.indexOf(',', start);
    if (end < 0) {
      end = length;
    }
    int colon = line.indexOf(':', start);
    if (colon < 0 || colon >= end) {
      return false;
    }

    String name = line.substring(start, colon);
    String value = line.substring(colon + 1, end);
    name.trim();
    value.trim();
    if (name.length() == 0 || value.length() == 0 || message.field(name).length() > 0) {
      return false;
    }
    message.fields[message.fieldCount] = {name, value};
    ++message.fieldCount;
  }
  return true;
}

String encodeMessage(const String& type, const String& target, const String& name, const String& value) {
  return type + "," + target + "," + name + ":" + value;
}

void sendMessage(const String& type, const String& target, const String& name, const String& value) {
  Serial.println(encodeMessage(type, target, name, value));
}

void setStreamEnabled(const SerialMessage& command, bool& streaming) {
  String state = command.field("stream_enabled");
  if (state != "0" && state != "1") {
    sendMessage("MCP", command.target, "error", "invalid_state");
    return;
  }
  streaming = state == "1";
  sendMessage("MCP", command.target, "stream_enabled", state);
}

$definitions

$handlers

void dispatchCommand(const SerialMessage& command) {
  if (command.type == "WRITE") {
$dispatch
  }
  sendMessage("MCP", command.target, "error", "unknown_command");
}

void setup() {
  Serial.begin($baud_rate);
$setup
}

void loop() {
$streams

  static String line;
  static bool oversized = false;
  while (Serial.available()) {
    char character = Serial.read();
    if (character == '\r') {
      continue;
    }
    if (character != '\n') {
      if (line.length() < $max_message_bytes) {
        line += character;
      } else {
        oversized = true;
      }
      continue;
    }

    if (!oversized) {
      SerialMessage message;
      if (decodeMessage(line, message)) {
        dispatchCommand(message);
      }
    }
    line = "";
    oversized = false;
  }
}
